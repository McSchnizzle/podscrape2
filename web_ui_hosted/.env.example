# Database
DATABASE_URL=postgresql://user:password@host:port/database

# Local Supabase-compatible data layer (docker/local-supabase, kanban #2846).
# SUPABASE_URL points at the local PostgREST/Caddy stack, not Supabase cloud.
# SUPABASE_SERVICE_ROLE is a JWT minted by
# docker/local-supabase/mint_supabase_jwt.py -- server-only, never expose as
# NEXT_PUBLIC_*.
SUPABASE_URL=http://127.0.0.1:5471
SUPABASE_SERVICE_ROLE=your-minted-service-role-jwt

# Admin login (app/login, app/api/auth/*). Google OAuth2 is the primary
# sign-in path (kanban #2846 Phase 3, direct flow -- NOT Supabase); the
# shared password below stays as a break-glass fallback on the same page.
ADMIN_PASSWORD=your-admin-password
# HMAC secret for the signed session cookie AND the OAuth `state` CSRF token
# (lib/session.ts, lib/google-oauth.ts). Generate with: openssl rand -hex 32
SESSION_SECRET=your-session-secret

# Google OAuth2 sign-in (app/api/auth/google, app/api/auth/callback/google).
# Client ID/secret come from the "Podcast Digest Admin" OAuth client in
# Google Cloud Console; the redirect URI
# https://podcast.paulrbrown.org/api/auth/callback/google is already
# registered on it. Leave both unset to disable Google sign-in and fall back
# to password-only (the login page hides the button automatically).
GOOGLE_OAUTH_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=your-client-secret
# Comma-separated, case-insensitive. Defaults to brownpr0@gmail.com (the
# pre-deletion-gate allowlist from utils/supabase-auth.ts) if unset.
ALLOWED_EMAILS=brownpr0@gmail.com
# Origin used to build the Google redirect_uri and OAuth-success redirects.
# Must exactly match the redirect URI registered on the Google OAuth client.
PUBLIC_BASE_URL=https://podcast.paulrbrown.org

# GitHub
GITHUB_TOKEN=your-github-token
GITHUB_REPOSITORY=owner/repo

# OpenAI & ElevenLabs (for pipeline dispatch)
OPENAI_API_KEY=your-openai-key
ELEVENLABS_API_KEY=your-elevenlabs-key
