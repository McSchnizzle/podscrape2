# Copy to .env next to this file (gitignored by the repo's root .env pattern)
# and fill in real values. Used by both docker-compose.yml and
# apply-roles.sh.

# Password for the `authenticator` Postgres login role that PostgREST
# connects as. Generate with: openssl rand -hex 24
AUTHENTICATOR_PASSWORD=

# HS256 secret PostgREST uses to verify the JWTs minted by
# mint_supabase_jwt.py. Generate with: openssl rand -hex 32
JWT_SECRET=

# Must match the existing podcast-db container's POSTGRES_DB / POSTGRES_USER
POSTGRES_DB=podcast
POSTGRES_USER=podcast

# Container name PostgREST reaches podcast-db at, over the shared
# "podcast-net" docker network
PODCAST_DB_CONTAINER=podcast-db
